# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs change; check what your free tier offers at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash

# Requests per minute the pipeline allows itself. Keep it below your free-tier limit.
GEMINI_RPM=10
# The vision model (Flash) has a lower free tier: 5 RPM, 20 requests per day.
GEMINI_VISION_RPM=4
TAG_BATCH_SIZE=8
SCANNED_PAGE_MIN_CHARS=60
OCR_DPI=200

# Phase B: retrieval
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
GEMINI_EMBED_RPM=20
RRF_K=60
EXTERNAL_WEIGHT=0.95
# memory (numpy + BM25, no setup) or pg (Postgres + pgvector; see exam_prep/pgstore.py)
RETRIEVAL_BACKEND=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/examprep
